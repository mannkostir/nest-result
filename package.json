{
  "name": "nest-result",
  "version": "0.2.0",
  "description": "Compiler-checked, exhaustive mapping of neverthrow Results to HTTP responses for NestJS, plus transactions that roll back on Err.",
  "keywords": [
    "nestjs",
    "neverthrow",
    "result",
    "typed-errors",
    "error-handling",
    "transactions"
  ],
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22.12.0"
  },
  "files": [
    "dist"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./swagger": {
      "import": {
        "types": "./dist/swagger.d.ts",
        "default": "./dist/swagger.js"
      },
      "require": {
        "types": "./dist/swagger.d.cts",
        "default": "./dist/swagger.cjs"
      }
    },
    "./transactional": {
      "import": {
        "types": "./dist/transactional.d.ts",
        "default": "./dist/transactional.js"
      },
      "require": {
        "types": "./dist/transactional.d.cts",
        "default": "./dist/transactional.cjs"
      }
    },
    "./unit-of-work": {
      "import": {
        "types": "./dist/unit-of-work.d.ts",
        "default": "./dist/unit-of-work.js"
      },
      "require": {
        "types": "./dist/unit-of-work.d.cts",
        "default": "./dist/unit-of-work.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "swagger": [
        "./dist/swagger.d.cts"
      ],
      "transactional": [
        "./dist/transactional.d.cts"
      ],
      "unit-of-work": [
        "./dist/unit-of-work.d.cts"
      ]
    }
  },
  "scripts": {
    "build": "tsup && node scripts/write-cjs-entry-points.js",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:diagnostics-snapshot": "vitest run --config vitest.snapshot.config.ts",
    "test:package": "vitest run --config vitest.package.config.ts",
    "example:build": "npm run build && rm -f examples/deals-api/nest-result-*.tgz && npm pack --pack-destination examples/deals-api && cd examples/deals-api && npm install && npm install --no-save ./nest-result-*.tgz && npm run build",
    "lint:package": "publint --strict && attw --pack .",
    "check": "npm run typecheck && npm test && npm run build && npm run test:package && npm run lint:package",
    "prepublishOnly": "npm run check"
  },
  "peerDependencies": {
    "@nestjs-cls/transactional": "^4.0.0",
    "@nestjs/common": "^11.0.0 || ^12.0.0",
    "@nestjs/core": "^11.0.0 || ^12.0.0",
    "@nestjs/swagger": "^11.0.0 || ^12.0.0",
    "nestjs-cls": "^7.0.0",
    "neverthrow": "^8.0.0",
    "reflect-metadata": "^0.1.12 || ^0.2.0",
    "rxjs": "^7.1.0",
    "typeorm-unit-of-work": ">=0.1.1 <2.0.0"
  },
  "peerDependenciesMeta": {
    "@nestjs-cls/transactional": {
      "optional": true
    },
    "@nestjs/swagger": {
      "optional": true
    },
    "nestjs-cls": {
      "optional": true
    },
    "typeorm-unit-of-work": {
      "optional": true
    }
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@nestjs-cls/transactional": "^4.0.1",
    "@nestjs-cls/transactional-adapter-typeorm": "^2.0.1",
    "@nestjs/common": "^12.1.2",
    "@nestjs/core": "^12.1.2",
    "@nestjs/platform-express": "^12.1.2",
    "@nestjs/platform-fastify": "^12.1.2",
    "@nestjs/swagger": "^12.0.2",
    "@nestjs/testing": "^12.1.2",
    "@swc/core": "^1.16.13",
    "@types/node": "^22.20.4",
    "@types/supertest": "^7.2.1",
    "better-sqlite3": "^12.11.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "expect-type": "^1.4.0",
    "nestjs-cls": "^7.0.1",
    "neverthrow": "^8.2.0",
    "publint": "^0.3.24",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "supertest": "^7.3.0",
    "tsup": "^8.5.1",
    "typeorm": "^1.1.1",
    "typeorm-unit-of-work": "^0.1.1",
    "typescript": "~6.0.3",
    "unplugin-swc": "^2.0.0",
    "vitest": "^5.0.3"
  },
  "allowScripts": {
    "@swc/core@1.16.13": true,
    "@scarf/scarf": false,
    "better-sqlite3@12.11.1": true,
    "esbuild": false,
    "fsevents": false
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mannkostir/nest-result.git"
  },
  "homepage": "https://github.com/mannkostir/nest-result#readme",
  "bugs": {
    "url": "https://github.com/mannkostir/nest-result/issues"
  }
}
